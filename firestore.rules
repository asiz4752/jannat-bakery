rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Customers can read the menu and read/create orders (no edits to the menu).
    match /menu/{itemId} {
      allow read: if true;
      allow write: if true;   // ⚠️ DEV ONLY – lock to admins (see README "Going to production")
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.total is number;
      allow update: if true;  // ⚠️ DEV ONLY – restrict to kitchen/admin staff
    }
  }
}
